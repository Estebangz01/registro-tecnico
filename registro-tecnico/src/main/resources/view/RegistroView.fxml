<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="360.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.registro.tecnico.controller.RegistroController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Registro de usuario" />
      <TextField fx:id="txtUsuario" promptText="Nombre de usuario" />
      <TextField fx:id="txtCorreo" promptText="Correo electrónico" />
      <PasswordField fx:id="txtPassword" promptText="Contraseña" />
      <PasswordField fx:id="txtConfirmacion" promptText="Confirmar contraseña" />
      <ComboBox fx:id="cmbRol" maxWidth="1.7976931348623157E308" promptText="Seleccione un rol" />
      <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrar" text="Registrarse" />
      <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#volver" text="Volver al inicio de sesión" />
   </children>
</VBox>